{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "includeFiles": "{app.html,i18n.js,data.js}"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/page?__p=/"
    },
    {
      "source": "/directory",
      "destination": "/api/page?__p=/directory"
    },
    {
      "source": "/map",
      "destination": "/api/page?__p=/map"
    },
    {
      "source": "/map/:slug",
      "destination": "/api/page?__p=/map/:slug"
    },
    {
      "source": "/about",
      "destination": "/api/page?__p=/about"
    },
    {
      "source": "/submit",
      "destination": "/api/page?__p=/submit"
    },
    {
      "source": "/friend/:slug",
      "destination": "/api/page?__p=/friend/:slug"
    },
    {
      "source": "/pref/:slug",
      "destination": "/api/page?__p=/pref/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    }
  ],
  "redirects": [
    {
      "source": "/index.html",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/app.html",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/(assets|fonts|_ds)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "images": {
    "sizes": [
      200,
      384,
      828,
      1600
    ],
    "formats": [
      "image/webp"
    ],
    "minimumCacheTTL": 2678400,
    "remotePatterns": [
      {
        "protocol": "https",
        "hostname": "csgfcyrooakfntvvzatn.supabase.co",
        "pathname": "/storage/v1/object/public/producer_images/**"
      }
    ]
  }
}
