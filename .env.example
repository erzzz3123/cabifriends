# Copy to .env.local for `vercel dev`. In production, set these in Vercel → Settings → Environment Variables.
# Never commit real values.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public "anon" key. Safe in the browser: row-level security limits it to published producers.
SUPABASE_ANON_KEY=public-anon-key
# Server-only secret. Bypasses row-level security. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=server-only-secret

# Optional: signs submission receipts and hashes visitor IPs for rate limiting.
# Defaults to the service-role key if unset. Any long random string.
SUBMIT_SECRET=

# ---- Optional: copy each new submission into an Airtable table ----
# (Producer sync, Dropbox and their secrets live in Supabase → Edge Functions → Secrets, not here.)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appdjYvUXMIWAs9go
AIRTABLE_SUBMISSIONS_TABLE=

# ---- SEO + analytics (optional) ----
# Canonical domain for page URLs, hreflang, the sitemap and share previews (no trailing slash).
SITE_URL=https://cabifriends.vercel.app
# Google Analytics 4 measurement ID, e.g. G-ABC123XYZ. Leave empty to turn analytics off.
GA_MEASUREMENT_ID=
