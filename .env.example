# Copy to .env.local for `vercel dev`. In production, set these in Vercel → Settings → Environment Variables.
# Never commit real values.

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public "anon" key. Safe in the browser: row-level security limits it to published producers.
SUPABASE_ANON_KEY=public-anon-key
# Server-only secret. Bypasses row-level security. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=server-only-secret

# Optional: signs submission receipts and hashes visitor IPs for rate limiting.
# Defaults to the service-role key if unset. Any long random string.
SUBMIT_SECRET=

# ---- Airtable (source of truth for producers) ----
# Personal access token for the WEBSITE: scope data.records:read only, access: the Cabi & Friends base only.
# (Add data.records:write only if you also set AIRTABLE_SUBMISSIONS_TABLE.)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=appdjYvUXMIWAs9go
# Optional: copy each new submission into this Airtable table.
AIRTABLE_SUBMISSIONS_TABLE=
# Optional: field ID of a "Published" checkbox. If unset, publish/unpublish stays in /admin.
AIRTABLE_PUBLISHED_FIELD=
# Lets Supabase Cron call /api/sync-airtable hourly. Must match the `cron_secret` Vault secret in Supabase.
CRON_SECRET=

# The Dropbox image sync does NOT use this file — its secrets live in Supabase → Edge Functions → Secrets.
# See README → "Dropbox image sync".
